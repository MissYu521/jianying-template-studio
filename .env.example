# 豆包大模型 API Key（火山方舟控制台获取）
DOUBAO_API_KEY=your_doubao_api_key_here

# 豆包大模型 API 基础地址
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 豆包多模态 VL 模型 ID（可选；也可填火山方舟推理接入点 ep-xxxx）
# DOUBAO_MODEL=doubao-1.5-vision-pro-32k-250115

# 开发调试：设为 true 时 AI 报告接口返回内置示例数据，不实际调用豆包 API
# DOUBAO_MOCK=false

# Vercel Blob 存储 Token（可选；Vercel 部署关联 Blob Store 后自动注入）
# BLOB_READ_WRITE_TOKEN=
